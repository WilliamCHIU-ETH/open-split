{
  "name": "@open-split/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply open-split --local --force",
    "dev": "pnpm --filter @open-split/web build && wrangler d1 migrations apply open-split --local --force && wrangler dev"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@open-split/auth": "workspace:*",
    "@open-split/contracts": "workspace:*",
    "@open-split/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "jose": "6.2.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261120.1",
    "@types/node": "26.6.6",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}
