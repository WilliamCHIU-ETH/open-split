{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-split",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  // Single-origin deployment (ADR-0010): serve apps/web/dist via Workers Static Assets
  // while keeping API, auth/OAuth, MCP, and health routes Worker-first.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/mcp",
      "/authorize",
      "/callback",
      "/oauth/*",
      "/.well-known/*",
      "/health"
    ]
  },
  // Node.js compatibility is already on for this date. Do not set nodejs_compat;
  // workerd rejects that flag once the compatibility date enables it.
  // database_id, kv id, and bucket_name below are placeholders until Slice 6+ prod setup.
  // Do not put real secrets in this file. Local secrets belong in .dev.vars.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // Top-level vars are what `wrangler deploy` ships. Fake login stays off.
  // Local `wrangler dev` overrides these from .dev.vars, which is not uploaded.
  "vars": {
    "ENVIRONMENT": "production",
    "AUTH_DEV_IDENTITIES": "false"
  },
  // Declared so 'wrangler types' generates these in Env in CI too (ADR-0001: do not hand-write Env).
  // Use .dev.vars locally and 'wrangler secret put' for deployments. Never put values here.
  "secrets": {
    "required": [
      "COOKIE_ENCRYPTION_KEY",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "MCP_ALLOWED_EMAILS",
      "PUBLIC_BASE_URL"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-split",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECEIPTS_BUCKET",
      "bucket_name": "open-split-receipts"
    }
  ]
}
