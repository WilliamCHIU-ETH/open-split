# Copy to .dev.vars. Wrangler loads .dev.vars for `wrangler dev` only and does not upload it.
# Never commit .dev.vars. Never set AUTH_DEV_IDENTITIES=true in wrangler.jsonc.

ENVIRONMENT=development
AUTH_DEV_IDENTITIES=true

# Test LINE Login channel from the LINE Developers console.
# The channel id and LIFF id identify the test channel. The channel secret is a secret:
# leave it empty in this example and put the real test secret only in .dev.vars.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LIFF_ID=

# MCP OAuth 2.1 (Cloudflare Workers OAuth Provider + Google OAuth + Gmail whitelist, ADR-0007).
# Local wrangler dev runs with AUTH_DEV_IDENTITIES=true so dev OAuth consent works without real secrets.
COOKIE_ENCRYPTION_KEY=dev-only-cookie-key-replace-in-prod-32chars
MCP_ALLOWED_EMAILS=owner@example.test
PUBLIC_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Official Account silent push. Not a chat bot. Later slice.
# LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
